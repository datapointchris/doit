{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:doit:desk-nudge-record:v5",
  "title": "doit.desk_nudge",
  "description": "One line of $XDG_STATE_HOME/doit/desk-nudge-events.jsonl, appended and never rotated, for a log shipper to read. This file is the source of the shape, and a Go test validates each line the watch writes against it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ts",
    "event",
    "fleet.schema_version"
  ],
  "properties": {
    "ts": {
      "type": "string",
      "format": "date-time",
      "description": "When it happened, in UTC."
    },
    "event": {
      "enum": [
        "started",
        "fired",
        "called",
        "answered",
        "expired",
        "picked",
        "gap",
        "paused",
        "resumed"
      ],
      "description": "What happened."
    },
    "fleet.schema_version": {
      "const": 5,
      "description": "This line's shape."
    },
    "doit_version": {
      "type": "string",
      "description": "The doit release the watch runs."
    },
    "phase": {
      "enum": [
        "counting",
        "firing",
        "ready",
        "paused",
        "no_desk"
      ],
      "description": "Where the clock stood when the watch started."
    },
    "nudge_id": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ],
      "description": "The firing's UUIDv7, which joins its answers and the service's row. Null where no nudge was in hand."
    },
    "interval_minutes": {
      "type": "number",
      "description": "The interval in force."
    },
    "counted_minutes": {
      "type": "number",
      "description": "The minutes counted toward the interval: time with a desk session since the last nudge ended."
    },
    "suggestion": {
      "description": "What the nudge suggested: /next's first offered pursuit and what it stands for, or why none was drawn.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pursuit",
            "item_id",
            "label"
          ],
          "properties": {
            "pursuit": {
              "type": "string",
              "description": "The pursuit /next offered first."
            },
            "item_id": {
              "type": [
                "string",
                "null"
              ],
              "description": "The id of its one resolved choice. Null where it resolved none, or several that only a person can choose between."
            },
            "label": {
              "type": "string",
              "description": "What doit next shows for it: each resolved choice on its own line, else the pursuit's description."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "error",
            "message",
            "detail"
          ],
          "properties": {
            "error": {
              "enum": [
                "unreachable",
                "login",
                "nothing_to_draw",
                "unreadable"
              ],
              "description": "Why /next drew nothing."
            },
            "message": {
              "type": "string",
              "description": "What the panel says instead."
            },
            "detail": {
              "type": "string",
              "description": "The service's or the client's own sentence."
            }
          }
        }
      ]
    },
    "sessions": {
      "description": "Every row of `claude-sessions --json`, whole, or why it could not be read.",
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "error"
          ],
          "properties": {
            "error": {
              "type": "string",
              "description": "Why the read failed or timed out."
            }
          }
        }
      ]
    },
    "focused_window": {
      "description": "The focused window, read through `hyprctl -i <instance> activewindow -j`, or why it could not be read.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "class",
            "title"
          ],
          "properties": {
            "class": {
              "type": [
                "string",
                "null"
              ]
            },
            "title": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "error"
          ],
          "properties": {
            "error": {
              "type": "string",
              "description": "Why the read failed or timed out."
            }
          }
        }
      ]
    },
    "answer": {
      "enum": [
        "good_timing",
        "too_soon",
        "too_late",
        "bothered"
      ],
      "description": "What the person said of the nudge."
    },
    "seconds_since_fired": {
      "type": "number",
      "description": "From the firing to the answer."
    },
    "saved": {
      "type": "boolean",
      "description": "Whether the service stored the answer."
    },
    "queued": {
      "type": "boolean",
      "description": "Whether the answer is kept on the desk to send again. A kept answer is written again once, with saved true once stored, or with both false once the service refuses it."
    },
    "late": {
      "type": "boolean",
      "description": "Whether its nudge had already ended, which leaves the clock alone."
    },
    "replaced": {
      "type": "array",
      "items": {
        "enum": [
          "good_timing",
          "too_soon",
          "too_late"
        ]
      },
      "description": "The nudge's other timing answers, which the service moved to its history for this one, because a nudge holds one timing answer. Empty where it held none."
    },
    "pick": {
      "type": "object",
      "additionalProperties": false,
      "description": "What a panel pick acted on, what it did, and how it came out.",
      "required": [
        "kind",
        "ref",
        "item_id",
        "minutes",
        "action",
        "outcome",
        "ok",
        "error"
      ],
      "properties": {
        "kind": {
          "$ref": "urn:doit:desk-panel-view:v1#/definitions/completion_kind"
        },
        "ref": {
          "type": "string",
          "description": "A pursuit's name, a habit's id, or a review register entry's id."
        },
        "item_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "The pursuit's choice that its on_log completed, where it named one, or the habit's checklist item that a tick or an untick changed."
        },
        "minutes": {
          "type": [
            "integer",
            "null"
          ],
          "description": "The minutes logged for a timed pursuit."
        },
        "action": {
          "enum": [
            "complete",
            "tick",
            "untick"
          ],
          "description": "What the pick did: complete its row, or record or take back one set of a checklist item."
        },
        "outcome": {
          "enum": [
            "done",
            "skipped",
            "refused",
            "uncertain"
          ],
          "description": "How it came out. skipped found the habit already done on the day it was picked, refused recorded nothing, and uncertain may have landed."
        },
        "ok": {
          "type": "boolean",
          "description": "Whether the completion went through."
        },
        "error": {
          "type": [
            "string",
            "null"
          ],
          "description": "Why it did not: the owner's refusal, or the command and how it failed."
        }
      }
    },
    "gap_seconds": {
      "type": "number",
      "description": "The time between two ticks, past two tick periods, which the clock does not count."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "event": {
            "const": "started"
          }
        }
      },
      "then": {
        "required": [
          "doit_version",
          "phase",
          "counted_minutes",
          "interval_minutes"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "fired"
          }
        }
      },
      "then": {
        "required": [
          "nudge_id",
          "interval_minutes",
          "counted_minutes",
          "suggestion",
          "sessions",
          "focused_window"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "called"
          }
        }
      },
      "then": {
        "required": [
          "nudge_id",
          "interval_minutes",
          "counted_minutes",
          "sessions",
          "focused_window"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "answered"
          }
        }
      },
      "then": {
        "required": [
          "nudge_id",
          "answer",
          "seconds_since_fired",
          "saved",
          "queued",
          "late"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "expired"
          }
        }
      },
      "then": {
        "required": [
          "nudge_id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "picked"
          }
        }
      },
      "then": {
        "required": [
          "nudge_id",
          "pick",
          "sessions",
          "focused_window"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "gap"
          }
        }
      },
      "then": {
        "required": [
          "gap_seconds"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "paused"
          }
        }
      },
      "then": {
        "required": [
          "nudge_id"
        ]
      }
    }
  ]
}
